# Copia este archivo a .env dentro de apps/phoenix-security y ajusta los valores.
# NUNCA commitear secretos reales. En producción, estos valores deben vivir en
# Azure Key Vault / App Service Configuration, nunca en el navegador ni en el repo.

# --- Servidor ---
PHX_PORT=4100
NODE_ENV=development

# --- Tenant de Microsoft 365 (Phoenix Service) ---
PHX_TENANT_ID=

# --- Identidad de solo lectura: "Phoenix Security Assessment – ReadOnly" ---
# Permisos de aplicación recomendados: User.Read.All, Group.Read.All,
# Organization.Read.All, Directory.Read.All, Reports.Read.All,
# SecurityEvents.Read.All, Policy.Read.All, DeviceManagementManagedDevices.Read.All
PHX_READONLY_CLIENT_ID=
PHX_READONLY_CLIENT_SECRET=

# --- Identidad de producción: "Phoenix Security Deployment – Production" ---
# Permisos de aplicación recomendados: User.ReadWrite.All, Organization.Read.All,
# LicenseAssignment.ReadWrite.All, Group.ReadWrite.All, Policy.ReadWrite.ConditionalAccess,
# DeviceManagementConfiguration.ReadWrite.All (según el módulo a desplegar)
PHX_PROD_CLIENT_ID=
PHX_PROD_CLIENT_SECRET=

# --- Control maestro de escrituras reales contra el tenant ---
# Debe permanecer en "false" salvo durante una ventana de cambio aprobada.
PHX_ENABLE_WRITES=false

# --- Aprobador único autorizado para la campaña masiva de licencias ---
PHX_LICENSE_APPROVER_UPN=juan.herrera@phoenixservice.com

# --- Azure Key Vault (opcional, cuando exista suscripción Azure) ---
PHX_KEYVAULT_URI=

# --- Carpeta del almacén de gobierno (cambios, auditoría, overrides) ---
# Déjala vacía en desarrollo local (usa ./data junto al código). En Azure
# App Service, si el sitio corre en modo "Run From Package" (wwwroot de solo
# lectura), fíjala a una ruta dentro de /home, ej: /home/data
PHX_DATA_DIR=

# --- Autenticación de la aplicación web (Azure App Service Easy Auth) ---
# En Azure App Service, activar "App Service Authentication" con proveedor Microsoft.
# En desarrollo local, sin Easy Auth disponible, se usa un usuario de demostración.
PHX_DEV_USER_UPN=demo.admin@phoenixservice.com
PHX_DEV_USER_NAME=Administrador de Demostración
PHX_DEV_USER_ROLES=GobiernoTI,Aprobador
